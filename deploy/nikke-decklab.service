# DILDORO 본체 — web/srv(정적 서빙 + 계산 + 공유·보드·지표, 사이드카 프록시).
# 계산은 컴파일된 코어(web/nikke_node.node, 서버에서 빌드)를 in-process로 부른다.
# 전투력·판독·조회는 사이드카(nikke-decklab-sidecar.service, 127.0.0.1:8768)로 넘긴다.
# 되돌리기: deploy/nikke-decklab-py.service 머리말 참조(유닛 복사 + daemon-reload + 재시작).
[Unit]
Description=DILDORO (web/srv — 정적 서빙 + 계산 + 사이드카 프록시)
Documentation=file:///home/ubuntu/nikke-calc/context/SERVER-CONTRACT.md
After=network-online.target tailscaled.service nikke-decklab-sidecar.service
Wants=network-online.target nikke-decklab-sidecar.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nikke-calc
# 0.0.0.0 바인드 — Funnel(로컬 프록시)과 테일넷 직통(/admin) 둘 다 받는다.
# 공인망 쪽 8766은 iptables INPUT(22 외 전부 REJECT)이 막고 있다.
# 런타임은 버전 고정으로 설치한다: curl -fsSL https://bun.sh/install | bash -s "bun-v1.4.0"
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/nikke-calc/web/srv/dist/srv.mjs --host 0.0.0.0 --port 8766 --sidecar http://127.0.0.1:8768
Restart=always
RestartSec=3
# 계산 스레드가 코어를 다 먹어 SSH까지 굶지 않게 한 단계 낮춘다 (파이썬 시절과 같은 정책)
Nice=5

CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes

# 유니온 레이드 공개 스위치 (web/srv의 health `union` 항목)
Environment=NIKKE_UNION=1

# ── 격리 ──────────────────────────────────────────────────────────────────
# 파일시스템 전체를 읽기 전용으로 두고, 쓰기 경로는 StateDirectory 하나만 준다
# (공유 링크 share.db · 운영 스위치 ops.json · 유입 집계).
StateDirectory=nikke-decklab
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
