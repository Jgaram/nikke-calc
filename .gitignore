# 개인 계정 데이터 — 어떤 경우에도 커밋 대상에 올리지 않는다
# (AGENTS.md §Repository contracts · .agent/skills/profile-sync/SKILL.md §절대 규칙)
profiles/
scraper/.session_cookie

# 빌드 산출물. 계산기 코드·데이터의 사본을 만들지 않는다 —
# `python web/build.py`가 매번 정본에서 다시 만든다.
web/dist/

# 유닛 없이 서버를 띄웠을 때의 공유 링크 저장소 (운영에서는 /var/lib/nikke-decklab).
# 하루 뒤 스스로 지워지는 캐시다 — 커밋할 것이 아니다.
web/.state/

# 보고서 작업 묶음 (스펙·중간 결과·캐시)
.report-work/

# 파이썬
__pycache__/
*.py[cod]

# 캡처 판독 시험용 스쿼드 캡처 모음 (남의 계정 화면이 섞여 있다 — 커밋하지 않는다).
# `python .shots/geo2.py`로 격자 검출을 재고, `mkvar.py`로 자르기 변형을 만든다.
.shots/

# blablalink API 덤프 — 유니온 멤버 닉네임·openid가 들어 있다. 저장소에 올리지 않는다.
# (scraper/cdn_locale.py의 보스 이름은 이 파일을 읽지만, 없으면 그 절만 비어 있을 뿐이다)
research/blablalink/api/

# 로컬 잔해 — 로그·크래시 덤프·공유 DB는 저장소에도 배포에도 안 간다
.dev.log
sh.exe.stackdump
web/.state/

# 컴파일된 계산 코어 — 서버(또는 로컬)에서 빌드해 web/ 옆에 둔다, 저장소에는 안 올린다
web/nikke_py.so
web/nikke_py.pyd
web/nikke_py.dll
web/nikke_node.node
web/srv/node_modules/
web/srv/dist/

# 배포용 tar (SITE.md §7) — 저장소에 올리지 않는다
n.tgz
